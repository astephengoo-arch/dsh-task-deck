{
  "name": "@local/dsh-task-deck",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "Task Deck — a personal multi-session mission control over the live DSH session catalog.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "license": "MIT",
  "author": "astephengoo-arch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astephengoo-arch/dsh-task-deck.git"
  },
  "homepage": "https://github.com/astephengoo-arch/dsh-task-deck#readme",
  "bugs": {
    "url": "https://github.com/astephengoo-arch/dsh-task-deck/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-management",
    "session-management",
    "sidebar"
  ],
  "scripts": {
    "validate": "node --check client.js && node --check index.js",
    "pack": "scripts/pack-release.sh"
  }
}
